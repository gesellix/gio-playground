# Copy to .env (not in git) and fill in. A variable set in the environment
# wins over .env, e.g. GIO=upstream scripts/ios.sh

# The build: fork (with the patches) or upstream (the state before them).
GIO=fork

# The app id (Android package, iOS bundle id). On iOS it must match the
# provisioning profile: scripts/ios.sh profiles lists them.
APP_ID=org.example.gioplayground
APP_NAME=GioPlayground
# The URL scheme the app registers, for the URL tests.
URL_SCHEME=gioplayground

# Android: the device, when more than one is connected (adb devices).
ANDROID_SERIAL=
ANDROID_ARCH=arm64
# A keystore to sign with; without it gogio uses a debug key.
ANDROID_SIGNKEY=
ANDROID_SIGNPASS=

# iOS: the provisioning profile (the path of its .mobileprovision file)
# and the device (its identifier or name, see scripts/ios.sh devices).
IOS_SIGNKEY=
IOS_DEVICE=
# The minimum iOS version; empty: the fork's gogio default (13), 15 for
# upstream gogio.
IOS_MINSDK=
